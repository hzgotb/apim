{
  "name": "@hzgotb/apim-nuxt",
  "version": "0.0.1",
  "description": "Nuxt module for typed API collections and the apim compile-time macro",
  "repository": {
    "type": "git",
    "url": "https://github.com/hzgotb/apim",
    "directory": "packages/nuxt"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hzgotb/apim-cli": "workspace:*",
    "@nuxt/kit": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "jiti": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "tinyglobby": "catalog:",
    "ufo": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    },
    "./apim": {
      "types": "./dist/apim.d.ts",
      "import": "./dist/apim.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/build-nuxt-dts.mjs",
    "prepack": "tsdown && node ../../scripts/build-nuxt-dts.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:",
    "@nuxt/nitro-server": "catalog:",
    "h3": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "ofetch": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  }
}
